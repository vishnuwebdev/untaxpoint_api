# Copy to .env (git-ignored) and fill in your values.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=untaxpoint
DB_USER=root
DB_PASSWORD=

# Long random string used to sign login tokens. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

# mock = no real money moves (until PayPal is connected)
PAYMENT_PROVIDER=mock
# How often (seconds) to check for events to start/settle
JOB_INTERVAL_SECONDS=60
# Allowed admin/web origins, comma separated (* = any, fine for local dev)
CORS_ORIGINS=*
